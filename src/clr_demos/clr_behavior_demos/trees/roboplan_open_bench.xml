<root main_tree_to_execute="MainTree">
  <!--
    Bench seat opening demo using the RoboPlan planning server.

    Sequence:
      1. Enable controllers.
      2. Home the arm, position rail/lift, approach bench seat.
      3. Allow gripper/lid collisions, compute the lid-opening arc,
         execute as a multi-waypoint Cartesian path.
      4. Be sure to reset the collisions regardless of success or
         failure.
      4. Back out with a relative Cartesian move.

    Requires the RoboPlan planning server, e.g.:
      ros2 launch clr_behavior_demos run_roboplan_behavior.launch.xml
  -->

  <include file="roboplan/gripper_trees.xml" />
  <include file="roboplan/roboplan_trees.xml" />

  <BehaviorTree ID="MainTree">
    <Sequence name="Sequence">

      <!-- Controller setup -->
      <GetRosControllerInfo
        name="get_controller_info"
        service_name="/controller_manager/list_controllers"
        controller_info="{controller_info}"
      />
      <SwitchRosControllers
        name="enable_clr_combined_controller"
        service_name="/controller_manager/switch_controller"
        service_timeout="3.0"
        controller_info="{controller_info}"
        activate_controllers="clr_joint_trajectory_controller"
      />

      <!-- Home the arm -->
      <SubTree ID="MoveToJointState"
        name="MoveToHome"
        group_name="ur_manipulator"
        joint_names="shoulder_pan_joint;shoulder_lift_joint;elbow_joint;wrist_1_joint;wrist_2_joint;wrist_3_joint"
        joint_positions="3.1927;-2.3913;-1.7760;-0.4700;-1.6177;-1.6134"
        velocity_scaling="1.0"
        acceleration_scaling="1.0"
      />

      <!-- Position rail and lift in front of the bench -->
      <SubTree ID="MoveToJointState"
        name="MoveToInit"
        group_name="clr"
        joint_names="vention_rail_base_to_carriage;ewellix_lift_lower_to_higher;shoulder_pan_joint;shoulder_lift_joint;elbow_joint;wrist_1_joint;wrist_2_joint;wrist_3_joint"
        joint_positions="0.0;0.0;2.5656;-3.0020;-0.9599;-0.6982;-1.5184;-1.0297"
        velocity_scaling="1.0"
        acceleration_scaling="1.0"
      />

      <!-- Move to underneath the bench -->
      <SubTree ID="MoveToJointState"
        name="MoveToApproachBenchSeat"
        group_name="ur_manipulator"
        joint_names="shoulder_pan_joint;shoulder_lift_joint;elbow_joint;wrist_1_joint;wrist_2_joint;wrist_3_joint"
        joint_positions="2.443;-2.670;-1.571;-0.419;-1.500;-0.925"
        velocity_scaling="1.0"
        acceleration_scaling="1.0"
      />

      <!-- Open bench seat, continue no matter what -->
      <FailureIsSuccess name="open_bench_with_cleanup">
        <SubTree ID="OpenBenchSeat" name="OpenBenchSeat" />
      </FailureIsSuccess>

      <!-- Reset collision scene -->
      <SetAllowedCollisions
        name="cleanup_lid_collisions"
        service_name="/roboplan_planning_server/set_collisions"
        body1="bench_lid;bench_lid;bench_lid"
        body2="finger_1_link;finger_2_link;gripper_base_link"
        allowed="false"
      />

      <!-- Back out the arm -->
      <LookupTransform
        name="lookup_tool_pose"
        source_frame="tool0"
        target_frame="world"
        target_T_source="{tool_in_world}"
      />
      <TransformStampedToPoseStamped
        name="tool_to_pose"
        transform_stamped="{tool_in_world}"
        pose_stamped="{current_pose}"
        child_frame_id="{_unused}"
      />
      <OffsetPoseStamped
        name="CalculateBackOutPose"
        input_pose="{current_pose}"
        translation_xyz="0.0, 0.0, -0.4"
        output_pose="{back_out_pose}"
      />
      <SubTree ID="MoveToPoseCartesian"
        name="BackOut"
        group_name="ur_manipulator"
        target_poses="{back_out_pose}"
      />

    </Sequence>
  </BehaviorTree>

  <!-- Bench-specific subtree to open the bench seat lid -->
  <BehaviorTree ID="OpenBenchSeat">
    <Sequence name="Sequence">

      <SetAllowedCollisions
        name="allow_lid_collisions"
        service_name="/roboplan_planning_server/set_collisions"
        body1="bench_lid;bench_lid;bench_lid"
        body2="finger_1_link;finger_2_link;gripper_base_link"
        allowed="true"
      />

      <ComputeBenchArcWaypoints
        name="compute_arc"
        hinge_frame="bench_lid"
        grasp_frame="grasp_frame"
        num_steps="8"
        rotation_per_step="-0.2014"
        rotation_axis_xyz="0.0, 1.0, 0.0"
        keep_start_orientation="true"
        waypoints="{arc_waypoints}"
      />

      <SubTree ID="MoveToPoseCartesian"
        name="ExecuteArc"
        group_name="ur_manipulator"
        target_poses="{arc_waypoints}"
      />

    </Sequence>
  </BehaviorTree>

</root>
