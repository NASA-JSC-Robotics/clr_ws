<root main_tree_to_execute="MainTree">
  <!--
    CTB pick-and-place demo using the RoboPlan planning server.

    Same task as pick_and_place_ctb.xml, with the motion planning swapped to
    the RoboPlan services: transit motions use free-space (RRT) planning,
    while the pre-grasp descent and post-grasp clear use constrained RRT*
    planning that keeps the gripper facing straight down. Trajectories are
    previewed as an RViz ghost before executing on the ROS 2 controllers.

    Requires the RoboPlan planning server, e.g.:
      ros2 launch clr_behavior_demos run_roboplan_behavior.launch.xml
  -->

  <include file="roboplan/gripper_trees.xml" />
  <include file="roboplan/perception_trees.xml" />
  <include file="roboplan/roboplan_trees.xml" />

  <BehaviorTree ID="MainTree">
    <Sequence name="Sequence">
      <GetRosControllerInfo name="get_controller_info"
        service_name="/controller_manager/list_controllers"
        controller_info="{controller_info}"
      />
      <SwitchRosControllers name="enable_clr_combined_controller"
        service_name="/controller_manager/switch_controller"
        service_timeout="3.0"
        controller_info="{controller_info}"
        activate_controllers="clr_joint_trajectory_controller"
      />

      <!-- Move to hardcoded perception pose and detect blobs -->
      <JointNamesAndPositionsFromYaml name="load_clr_ctb_demo_perception"
        package_name="clr_behavior_demos"
        yaml_file="config/clr_poses.yaml"
        state_name="clr_ctb_demo_perception"
        joint_names="{clr_ctb_demo_perception_joint_names}"
        joint_positions="{clr_ctb_demo_perception_joint_positions}"
      />
      <SubTree ID="MoveToJointState"
        name="MoveToDemoHome"
        group_name="clr"
        joint_names="{clr_ctb_demo_perception_joint_names}"
        joint_positions="{clr_ctb_demo_perception_joint_positions}"
        velocity_scaling="1.0"
        acceleration_scaling="1.0"
      />
      <SubTree ID="DetectBlobs"
        name="DetectHandle"
        target_color="red"
        blob_pose="{ctb_handle_pose}"
        debug_viz="false"
      />
      <TransformPose name="transform_to_base"
        input_pose="{ctb_handle_pose}"
        source_frame="world"
        output_pose="{ctb_handle_pose_base}"
      />
      <AlignPoseToNearestAxis name="align_handle_pose"
        input_pose="{ctb_handle_pose_base}"
        output_pose="{ctb_handle_pose_aligned}"
      />

      <!-- Approach and grasp (chonkur_grasp for precision) -->
      <!-- TODO: CTB pick in it's own tree? -->
      <SubTree ID="OpenGripper" name="open_gripper_start" />
      <OffsetPoseStamped name="calculate_approach_pose"
        input_pose="{ctb_handle_pose_aligned}"
        translation_xyz="0.0, 0.0, 0.1"
        output_pose="{ctb_approach_pose}"
      />
      <SubTree ID="MoveToPose"
        name="MoveToApproach"
        group_name="chonkur_grasp"
        target_pose="{ctb_approach_pose}"
        velocity_scaling="1.0"
        acceleration_scaling="1.0"
        constrain_gripper_top_down="false"
      />
      <OffsetPoseStamped name="calculate_grasp_pose"
        input_pose="{ctb_handle_pose_aligned}"
        translation_xyz="0.0, 0.0, -0.03"
        output_pose="{ctb_grasp_pose}"
      />
      <SubTree ID="MoveToPoseCartesian"
        name="DescendToGrasp"
        group_name="chonkur_grasp"
        target_poses="{ctb_grasp_pose}"
      />
      <SubTree ID="CloseGripper" name="close_gripper" />

      <!-- Short lift of the CTB off the ground -->
      <OffsetPoseStamped name="CalculateLiftPose"
        input_pose="{ctb_handle_pose_aligned}"
        translation_xyz="0.0, 0.0, 0.2"
        output_pose="{ctb_lift_pose}"
      />
      <SubTree ID="MoveToPoseCartesian"
        name="LiftBag"
        group_name="chonkur_grasp"
        target_poses="{ctb_lift_pose}"
      />

      <!-- Tuck in (chonkur_grasp, small Y shift to clear mockups) -->
      <!-- TODO: Make this better? This could not vibe with the place depending -->
      <!-- on the joint angles that the RRT ends up with -->
      <LookupTransform name="lookup_post_lift"
        source_frame="grasp_frame"
        target_frame="world"
        target_T_source="{post_lift_tf}"
      />
      <TransformStampedToPoseStamped name="post_lift_to_pose"
        transform_stamped="{post_lift_tf}"
        pose_stamped="{post_lift_pose}"
        child_frame_id="{_unused_1}"
      />
      <OffsetPoseStamped name="CalculateTuckPose" input_pose="{post_lift_pose}"
        translation_xyz="0.0, -0.1, 0.0"
        output_pose="{tuck_pose}"
      />
      <SubTree ID="MoveToPoseCartesian"
        name="TuckIn"
        group_name="chonkur_grasp"
        target_poses="{tuck_pose}"
      />

      <!-- Raise the lift to clear bench height -->
      <SubTree ID="MoveToJointState"
        name="RaiseLift"
        group_name="lift"
        joint_names="ewellix_lift_lower_to_higher"
        joint_positions="0.6"
        velocity_scaling="1.0"
        acceleration_scaling="1.0"
      />

      <!-- Traverse rail toward bench -->
      <SubTree ID="MoveToJointState"
        name="TraverseLeft1"
        group_name="rail"
        joint_names="vention_rail_base_to_carriage"
        joint_positions="0.0"
        velocity_scaling="1.0"
        acceleration_scaling="1.0"
      />

      <!-- We compute the drop pose relative the center of the bench frame -->
      <!-- 50cm above the center of the bench, gripper pointing down -->
      <CreatePoseStamped name="create_above_bench_pose"
        position_xyz="-1.65, 0.78, 1.35"
        orientation_xyzw="0.0, 1.0, 0.0, 0.0"
        frame="world"
        msg="{above_bench_pose_world}"
      />

      <!-- Transform to chonkur_grasp's base frame because that's what the server expects -->
      <TransformPose name="transform_to_base_again"
        input_pose="{above_bench_pose_world}"
        source_frame="vention_rail_base_link"
        output_pose="{above_bench_pose}"
      />

      <!-- Attempt to RRT to above the bench -->
      <SubTree ID="MoveToPose"
        name="MoveAboveBench"
        group_name="chonkur_grasp"
        target_pose="{above_bench_pose}"
        velocity_scaling="1.0"
        acceleration_scaling="1.0"
        constrain_gripper_top_down="false"
      />

      <!-- Lower lift to bring CTB down to bench height -->
      <SubTree ID="MoveToJointState"
        name="LowerLift"
        group_name="lift"
        joint_names="ewellix_lift_lower_to_higher"
        joint_positions="0.0"
        velocity_scaling="1.0"
        acceleration_scaling="1.0"
      />

      <!-- Short Cartesian down into the bench -->
      <LookupTransform name="lookup_pre_drop"
        source_frame="grasp_frame"
        target_frame="world"
        target_T_source="{pre_drop_tf}"
      />
      <TransformStampedToPoseStamped name="pre_drop_to_pose"
        transform_stamped="{pre_drop_tf}"
        pose_stamped="{pre_drop_pose}"
        child_frame_id="{_unused_2}"
      />
      <OffsetPoseStamped name="calculate_drop_pose"
        input_pose="{pre_drop_pose}"
        translation_xyz="0.0, 0.0, -0.05"
        output_pose="{drop_pose}"
      />
      <SubTree ID="MoveToPoseCartesian"
        name="LowerIntoBench"
        group_name="chonkur_grasp"
        target_poses="{drop_pose}"
      />

      <SubTree ID="OpenGripper" name="open_gripper_end" />

      <!-- Back off -->
      <OffsetPoseStamped name="CalculateBackoffPose"
        input_pose="{drop_pose}"
        translation_xyz="0.0, 0.0, 0.15"
        output_pose="{backed_off_pose}"
      />
      <SubTree ID="MoveToPoseCartesian"
        name="BackOff"
        group_name="chonkur_grasp"
        target_poses="{backed_off_pose}"
      />

    </Sequence>
  </BehaviorTree>

</root>
