<root main_tree_to_execute="MainTree">
  <!--
    CTB pick-and-place demo using the RoboPlan planning server.

    Same task as pick_and_place_ctb.xml, with the motion planning swapped to
    the RoboPlan services: transit motions use free-space (RRT) planning,
    while the pre-grasp descent and post-grasp lift use straight-line
    Cartesian planning. Trajectories are previewed as an RViz ghost before
    executing on the ROS 2 controllers.

    Requires the RoboPlan planning server, e.g.:
      ros2 launch clr_behavior_demos run_roboplan_behavior.launch.xml
  -->
  <BehaviorTree ID="MainTree">
    <Sequence name="Sequence">
      <GetRosControllerInfo
        name="get_controller_info"
        service_name="/controller_manager/list_controllers"
        controller_info="{controller_info}"
      />
      <SwitchRosControllers
        name="enable_clr_combined_controller"
        service_name="/controller_manager/switch_controller"
        service_timeout="3.0"
        controller_info="{controller_info}"
        activate_controllers="clr_joint_trajectory_controller"
      />
      <SubTree ID="OpenGripper" name="open_gripper_start" />
      <CreatePoseStamped
        name="set_perception_pose"
        position_xyz="0.45, 0.75, 1.29"
        orientation_wxyz="0.0, 0.0, 1.0, 0.0"
        frame="world"
        msg="{perception_pose}"
      />
      <SubTree ID="MoveToPose"
        name="MoveToPerceptionPose"
        group_name="clr"
        target_pose="{perception_pose}"
      />
      <SubTree ID="DetectBlobs"
        name="DetectHandle"
        target_color="red"
        blob_pose="{ctb_handle_pose}"
        debug_viz="false"
      />
      <TransformPose name="TransformToBase"
        input_pose="{ctb_handle_pose}"
        source_frame="world"
        output_pose="{ctb_handle_pose_base}"
      />
      <AlignPoseToNearestAxis name="AlignHandlePose"
        input_pose="{ctb_handle_pose_base}"
        output_pose="{ctb_handle_pose_aligned}"
      />
      <OffsetPoseStamped name="CalculateApproachPose"
        input_pose="{ctb_handle_pose_aligned}"
        translation_xyz="0.0, 0.0, 0.1"
        output_pose="{ctb_approach_pose}"
      />
      <SubTree ID="MoveToPose"
        name="MoveToApproach"
        group_name="clr"
        target_pose="{ctb_approach_pose}"
      />
      <OffsetPoseStamped name="CalculateGraspPose"
        input_pose="{ctb_handle_pose_aligned}"
        translation_xyz="0.0, 0.0, -0.03"
        output_pose="{ctb_grasp_pose}"
      />
      <SubTree ID="MoveToPoseCartesian"
        name="MoveToGrasp"
        group_name="clr"
        target_pose="{ctb_grasp_pose}"
      />
      <SubTree ID="CloseGripper" name="close_gripper" />
      <OffsetPoseStamped name="CalculateLiftPose"
        input_pose="{ctb_handle_pose_aligned}"
        translation_xyz="0.0, 0.0, 0.6"
        output_pose="{ctb_lift_pose}"
      />
      <SubTree ID="MoveToPoseCartesian"
        name="LiftBag"
        group_name="clr"
        target_pose="{ctb_lift_pose}"
      />
      <CreatePoseStamped
        name="set_drop_pose"
        position_xyz="-1.5675, 0.753, 1.3"
        orientation_wxyz="0.0, 0.0, 1.0, 0.0"
        frame="world"
        msg="{drop_pose}"
      />
      <SubTree ID="MoveToPose"
        name="MoveToDropPose"
        group_name="clr"
        target_pose="{drop_pose}"
      />
      <SubTree ID="OpenGripper" name="open_gripper_end" />
    </Sequence>
  </BehaviorTree>

  <!-- Free-space (RRT) plan, ghost preview, and execute -->
  <BehaviorTree ID="MoveToPose">
    <Sequence name="Sequence">
      <Retry name="retry" num_failures="3">
        <RoboplanPlanToPose
          name="plan_to_pose"
          service_name="/roboplan_planning_server/plan_to_pose"
          group_name="{group_name}"
          target_pose="{target_pose}"
          velocity_scaling="1.0"
          acceleration_scaling="1.0"
          trajectory="{trajectory}"
        />
      </Retry>
      <CallTriggerService
        name="preview_trajectory"
        service_name="/roboplan_planning_server/preview"
      />
      <ExecuteJointTrajectory
        name="execute_trajectory"
        action_name="/clr_joint_trajectory_controller/follow_joint_trajectory"
        trajectory="{trajectory}"
      />
    </Sequence>
  </BehaviorTree>

  <!-- Straight-line Cartesian plan, ghost preview, and execute -->
  <BehaviorTree ID="MoveToPoseCartesian">
    <Sequence name="Sequence">
      <Retry name="retry" num_failures="3">
        <RoboplanPlanCartesianPath
          name="plan_cartesian_path"
          service_name="/roboplan_planning_server/plan_cartesian_path"
          group_name="{group_name}"
          target_pose="{target_pose}"
          trajectory="{trajectory}"
        />
      </Retry>
      <CallTriggerService
        name="preview_trajectory"
        service_name="/roboplan_planning_server/preview"
      />
      <ExecuteJointTrajectory
        name="execute_trajectory"
        action_name="/clr_joint_trajectory_controller/follow_joint_trajectory"
        trajectory="{trajectory}"
      />
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="OpenGripper">
    <CommandGripper
      name="OpenGripper"
      action_name="/robotiq_gripper_hande_controller/gripper_cmd"
      position="0.023"
    />
  </BehaviorTree>

  <BehaviorTree ID="CloseGripper">
    <CommandGripper
      name="CloseGripper"
      action_name="/robotiq_gripper_hande_controller/gripper_cmd"
      position="0.0005"
    />
  </BehaviorTree>

  <!-- Perception behavior -->
  <BehaviorTree ID="DetectBlobs">
    <Sequence name="Sequence">
      <GetSyncedImagePointCloudDepth
        name="get_synced_images_pointcloud"
        camera_info_topic="/wrist_mounted_camera/color/camera_info"
        rgb_image_topic="/wrist_mounted_camera/color/image_raw"
        depth_image_topic="/wrist_mounted_camera/aligned_depth_to_color/image_raw"
        point_cloud_topic="/wrist_mounted_camera/depth/color/points"
        time_slop="0.1"
        sync_timeout="3.0"
        camera_info="{camera_info}"
        rgb_image="{rgb_image}"
        depth_image="{depth_image}"
        point_cloud="{point_cloud}"
      />
      <DetectColorBlobs
        name="detect_color_blobs"
        camera_info="{camera_info}"
        rgb_image="{rgb_image}"
        depth_image="{depth_image}"
        target_color="{target_color}"
        min_blob_size="10"
        debug_viz="{debug_viz}"
        masked_image="{masked_image}"
        blob_pose="{blob_pose}"
      />
    </Sequence>
  </BehaviorTree>

</root>
