<root>
  <!--
    Shared RoboPlan subtrees for planning, previewing, and executing
    trajectories. Include these in any demo tree that uses the RoboPlan
    planning server.
  -->

  <!-- Free-space plan to a joint configuration, preview, execute -->
  <BehaviorTree ID="MoveToJointState">
    <Sequence name="Sequence">
      <Retry name="retry" num_failures="3">
        <RoboplanPlanToJointState
          name="plan_to_joint_state"
          service_name="/roboplan_planning_server/plan_to_joint_state"
          group_name="{group_name}"
          joint_names="{joint_names}"
          joint_positions="{joint_positions}"
          velocity_scaling="{velocity_scaling}"
          acceleration_scaling="{acceleration_scaling}"
          trajectory="{trajectory}"
        />
      </Retry>
      <CallTriggerService
        name="preview_trajectory"
        service_name="/roboplan_planning_server/preview"
      />
      <WaitForDuration name="wait_for_preview" duration_sec="2.0" />
      <ExecuteJointTrajectory
        name="execute_trajectory"
        action_name="/clr_joint_trajectory_controller/follow_joint_trajectory"
        trajectory="{trajectory}"
      />
    </Sequence>
  </BehaviorTree>

  <!-- Free-space (RRT) plan to a pose, preview, execute.
       constrain_gripper_top_down switches to constrained (RRT*) planning
       that keeps the gripper facing straight down along the whole path. -->
  <BehaviorTree ID="MoveToPose">
    <Sequence name="Sequence">
      <Retry name="retry" num_failures="3">
        <RoboplanPlanToPose
          name="plan_to_pose"
          service_name="/roboplan_planning_server/plan_to_pose"
          group_name="{group_name}"
          target_pose="{target_pose}"
          velocity_scaling="{velocity_scaling}"
          acceleration_scaling="{acceleration_scaling}"
          constrain_gripper_top_down="{constrain_gripper_top_down}"
          trajectory="{trajectory}"
        />
      </Retry>
      <CallTriggerService
        name="preview_trajectory"
        service_name="/roboplan_planning_server/preview"
      />
      <WaitForDuration name="wait_for_preview" duration_sec="2.0" />
      <ExecuteJointTrajectory
        name="execute_trajectory"
        action_name="/clr_joint_trajectory_controller/follow_joint_trajectory"
        trajectory="{trajectory}"
      />
    </Sequence>
  </BehaviorTree>

  <!-- Straight-line Cartesian plan through one or more poses, preview, execute -->
  <BehaviorTree ID="MoveToPoseCartesian">
    <Sequence name="Sequence">
      <RoboplanPlanCartesianPath
        name="plan_cartesian_path"
        service_name="/roboplan_planning_server/plan_cartesian_path"
        group_name="{group_name}"
        target_poses="{target_poses}"
        trajectory="{trajectory}"
      />
      <CallTriggerService
        name="preview_trajectory"
        service_name="/roboplan_planning_server/preview"
      />
      <WaitForDuration name="wait_for_preview" duration_sec="2.0" />
      <ExecuteJointTrajectory
        name="execute_trajectory"
        action_name="/clr_joint_trajectory_controller/follow_joint_trajectory"
        trajectory="{trajectory}"
      />
    </Sequence>
  </BehaviorTree>

</root>
