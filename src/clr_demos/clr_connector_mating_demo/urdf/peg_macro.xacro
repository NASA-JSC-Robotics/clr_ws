<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <!--
    Cylindrical peg tool for the connector mating demo.

    The peg is a cylinder of the given radius and length with a 45 degree
    chamfer at the tip to give the insertion a lead-in. Its base sits at the
    macro origin and it extends along the parent's +z axis, i.e. straight out
    of the gripper. The `peg_tip` frame is placed at the very end of the peg
    with z pointing out along the peg axis, matching the `grasp_frame`
    convention, so it can be used as a planning tip link.

    The geometry comes from meshes/visual/chamfered_peg.stl, generated by
    scripts/generate_peg_mesh.py; regenerate it if the dimensions below change.

    The receptacle bore is 50 mm in diameter and 110 mm deep, so the default
    44 mm peg leaves 3 mm of radial clearance.
  -->
  <xacro:macro name="peg" params="
    prefix:=''
    parent
    *origin
    radius:=0.022
    length:=0.157
    mass:=0.3">

    <material name="${prefix}peg_orange">
      <color rgba="0.9 0.45 0.1 1.0"/>
    </material>

    <joint name="${prefix}peg_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}peg_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <link name="${prefix}peg_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://clr_connector_mating_demo/meshes/visual/chamfered_peg.stl"/>
        </geometry>
        <material name="${prefix}peg_orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://clr_connector_mating_demo/meshes/visual/chamfered_peg.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${length / 2}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia
          ixx="${mass * (3 * radius * radius + length * length) / 12}"
          iyy="${mass * (3 * radius * radius + length * length) / 12}"
          izz="${mass * radius * radius / 2}"
          ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <joint name="${prefix}peg_tip_joint" type="fixed">
      <parent link="${prefix}peg_link"/>
      <child link="${prefix}peg_tip"/>
      <origin xyz="0 0 ${length}" rpy="0 0 0"/>
    </joint>
    <link name="${prefix}peg_tip"/>

  </xacro:macro>

</robot>
