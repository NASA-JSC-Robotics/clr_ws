# Plans a straight-line Cartesian motion through one or more target poses,
# interpolating between consecutive poses and solving IK along the path.
# A single target pose (the common case) produces a straight line from the
# current end effector pose to the target.
#
# The joint group to plan for. An empty string uses the server's default group.
string group_name

# One or more target poses, visited in order. Each pose is interpreted in the
# frame given by its header.frame_id, which must be a frame known to the
# planning scene. An empty frame_id means the planning group's base link.
geometry_msgs/PoseStamped[] target_poses

# Optional tool speed limits along the path. Values <= 0 use the server's
# defaults. Only applies when the server's Cartesian speed mode is "bounded";
# in "time_optimal" mode the trajectory is timed against the joint limits.
float64 max_linear_speed
float64 max_angular_speed

---

bool success
string message
trajectory_msgs/JointTrajectory trajectory
